<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>maman dèlices</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  background: #f4f4f4;
  direction: rtl;
}

header {
  background: #ff5e78;
  color: white;
  padding: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 22px;
  font-weight: bold;
}

.container {
  padding: 20px;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 15px;
}

.card {
  background: white;
  border-radius: 10px;
  overflow: hidden;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.card img {
  width: 100%;
  height: 120px;
  object-fit: cover;
}

.card button {
  background: #ff5e78;
  color: white;
  border: none;
  padding: 10px;
  width: 100%;
  cursor: pointer;
}

.cart-btn {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: black;
  color: white;
  padding: 15px;
  border-radius: 50%;
  cursor: pointer;
}
</style>
</head>

<body>

<header>
  <div class="logo">maman dèlices</div>
</header>

<div class="container">
  <h2>منتجاتنا</h2>
  <div class="products" id="products"></div>
</div>

<div class="cart-btn" onclick="checkout()">🛒</div>

<script>
let cart = [];

let products = [
  {
    name: "كيك شوكولا",
    price: 1200,
    img: "https://images.unsplash.com/photo-1605478371310-a9f1e96b4ff4"
  },
  {
    name: "بسكويت",
    price: 500,
    img: "https://images.unsplash.com/photo-1589307004394-0a4f6b2a74c4"
  },
  {
    name: "حلويات تقليدية",
    price: 800,
    img: "https://images.unsplash.com/photo-1600891964599-f61ba0e24092"
  }
];

function loadProducts() {
  let html = "";
  products.forEach((p, i) => {
    html += `
      <div class="card">
        <img src="${p.img}">
        <h3>${p.name}</h3>
        <p>${p.price} دج</p>
        <button onclick="addToCart(${i})">أضف للسلة</button>
      </div>
    `;
  });
  document.getElementById("products").innerHTML = html;
}

function addToCart(i) {
  cart.push(products[i]);
  alert("تمت الإضافة للسلة");
}

function checkout() {
  let msg = "طلب جديد:\n";
  cart.forEach(p => {
    msg += p.name + " - " + p.price + " دج\n";
  });

  window.open("https://wa.me/213561447654?text=" + encodeURIComponent(msg));
}

loadProducts();
</script>

</body>
</html>
